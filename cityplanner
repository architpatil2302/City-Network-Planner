
#include <stdio.h>
#include <string.h>

#define MAX_VERTICES 50
#define MAX_EDGES 100

struct Edge
{
    int source;
    int destination;
    int cost;
};

char city[MAX_VERTICES][50];
struct Edge edges[MAX_EDGES];
struct Edge mst[MAX_VERTICES - 1];
struct Edge rejected[MAX_EDGES];

int vertices = 0;
int edgeCount = 0;
int mstCount = 0;
int rejectedCount = 0;
int totalCost = 0;

int parent[MAX_VERTICES];
int rankSet[MAX_VERTICES];

int find(int x)
{
    if (parent[x] != x)
        parent[x] = find(parent[x]);

    return parent[x];
}

void unionSet(int x, int y)
{
    int rootX = find(x);
    int rootY = find(y);

    if (rootX == rootY)
        return;

    if (rankSet[rootX] < rankSet[rootY])
        parent[rootX] = rootY;
    else if (rankSet[rootX] > rankSet[rootY])
        parent[rootY] = rootX;
    else
    {
        parent[rootY] = rootX;
        rankSet[rootX]++;
    }
}

int getCityIndex(char name[])
{
    int i;

    for (i = 0; i < vertices; i++)
    {
        if (strcmp(city[i], name) == 0)
            return i;
    }

    return -1;
}

void enterCities()
{
    int i, j, n;

    printf("\nEnter number of cities (1-%d): ", MAX_VERTICES);

    if (scanf("%d", &n) != 1 || n < 1 || n > MAX_VERTICES)
    {
        printf("Invalid number of cities.\n");
        return;
    }

    vertices = n;
    edgeCount = 0;
    mstCount = 0;
    rejectedCount = 0;
    totalCost = 0;

    for (i = 0; i < vertices; i++)
    {
        while (1)
        {
            printf("Enter name of city %d: ", i + 1);
            scanf("%49s", city[i]);

            for (j = 0; j < i; j++)
            {
                if (strcmp(city[i], city[j]) == 0)
                    break;
            }

            if (j == i)
                break;

            printf("City name already exists. Try again.\n");
        }
    }

    printf("\nCities added successfully.\n");
}

void displayCities()
{
    int i;

    if (vertices == 0)
    {
        printf("\nPlease enter cities first.\n");
        return;
    }

    printf("\nAvailable Cities:\n");

    for (i = 0; i < vertices; i++)
        printf("%d. %s\n", i + 1, city[i]);
}


void addConnection()
{
    char sourceName[50];
    char destinationName[50];
    int sourceIndex, destinationIndex;
    int cost, n, i;

    if (vertices == 0)
    {
        printf("\nPlease enter cities first.\n");
        return;
    }

    printf("\nEnter number of connections: ");

    if (scanf("%d", &n) != 1 ||
        n < 0 || n > MAX_EDGES - edgeCount)
    {
        printf("\nInvalid number of connections.\n");
        return;
    }

    for (i = 0; i < n; i++)
    {
        printf("Enter source city, destination city and cost: ");

        if (scanf("%49s %49s %d",
                  sourceName, destinationName, &cost) != 3)
        {
            printf("\nInvalid input.\n");
            return;
        }

        sourceIndex = getCityIndex(sourceName);
        destinationIndex = getCityIndex(destinationName);

        if (sourceIndex == -1 || destinationIndex == -1)
        {
            printf("Invalid city name. Try again.\n");
            i--;
            continue;
        }

        if (sourceIndex == destinationIndex)
        {
            printf("A city cannot connect to itself. Try again.\n");
            i--;
            continue;
        }

        if (cost < 0)
        {
            printf("Cost cannot be negative. Try again.\n");
            i--;
            continue;
        }

        edges[edgeCount].source = sourceIndex;
        edges[edgeCount].destination = destinationIndex;
        edges[edgeCount].cost = cost;

        edgeCount++;
    }

    mstCount = 0;
    rejectedCount = 0;
    totalCost = 0;

    printf("\nAll connections added successfully.\n");
}

void displayConnections()
{
    int i;

    if (edgeCount == 0)
    {
        printf("\nNo connections available.\n");
        return;
    }

    printf("\n%-20s %-20s %-10s\n",
           "Source", "Destination", "Cost");

    printf("--------------------------------------------------\n");

    for (i = 0; i < edgeCount; i++)
    {
        printf("%-20s %-20s %-10d\n",
               city[edges[i].source],
               city[edges[i].destination],
               edges[i].cost);
    }
}

void sortEdges()
{
    int i, j;
    struct Edge temp;

    for (i = 0; i < edgeCount - 1; i++)
    {
        for (j = 0; j < edgeCount - i - 1; j++)
        {
            if (edges[j].cost > edges[j + 1].cost)
            {
                temp = edges[j];
                edges[j] = edges[j + 1];
                edges[j + 1] = temp;
            }
        }
    }
}

void initializeSets()
{
    int i;

    for (i = 0; i < vertices; i++)
    {
        parent[i] = i;
        rankSet[i] = 0;
    }
}

void kruskal()
{
    int i;
    int rootSource, rootDestination;

    mstCount = 0;
    rejectedCount = 0;
    totalCost = 0;

    if (vertices == 0)
    {
        printf("\nPlease enter cities first.\n");
        return;
    }

    initializeSets();
    sortEdges();

    printf("\n============================================\n");
    printf("          KRUSKAL'S ALGORITHM\n");
    printf("============================================\n");

    printf("\n%-20s %-10s %-20s\n",
           "Connection", "Cost", "Decision");

    printf("--------------------------------------------------\n");

    for (i = 0; i < edgeCount; i++)
    {
        rootSource = find(edges[i].source);
        rootDestination = find(edges[i].destination);

        if (rootSource != rootDestination)
        {
            mst[mstCount] = edges[i];
            mstCount++;
            totalCost += edges[i].cost;

            unionSet(rootSource, rootDestination);

            printf("%s - %s\t%d\tACCEPT\n",
                   city[edges[i].source],
                   city[edges[i].destination],
                   edges[i].cost);
        }
        else
        {
            rejected[rejectedCount] = edges[i];
            rejectedCount++;

            printf("%s - %s\t%d\tREJECT - CYCLE\n",
                   city[edges[i].source],
                   city[edges[i].destination],
                   edges[i].cost);
        }
    }

    printf("\n============================================\n");

    if (vertices == 1)
    {
        printf("Only one city exists.\n");
        printf("Minimum Cost = 0\n");
        return;
    }

    if (mstCount != vertices - 1)
    {
        printf("MST cannot be formed.\n");
        printf("The network is disconnected.\n");
        return;
    }

    printf("Minimum Spanning Tree created successfully.\n");
    printf("Total Minimum Cost = %d\n", totalCost);
}

void displayMST()
{
    int i;

    if (vertices == 0)
    {
        printf("\nPlease enter cities first.\n");
        return;
    }

    if (vertices > 1 && mstCount == 0)
    {
        printf("\nPlease generate the minimum-cost network first.\n");
        return;
    }

    printf("\n============================================\n");
    printf("       MINIMUM SPANNING TREE (MST)\n");
    printf("============================================\n");

    if (vertices == 1)
    {
        printf("Only one city exists. No connections required.\n");
        printf("Total Minimum Cost = 0\n");
        return;
    }

    if (mstCount != vertices - 1)
    {
        printf("MST cannot be formed because the network is disconnected.\n");
        return;
    }

    for (i = 0; i < mstCount; i++)
    {
        printf("%s - %s : %d\n",
               city[mst[i].source],
               city[mst[i].destination],
               mst[i].cost);
    }

    printf("--------------------------------------------\n");
    printf("Total Minimum Cost = %d\n", totalCost);
}

void displayRejected()
{
    int i;

    if (vertices == 0)
    {
        printf("\nPlease enter cities first.\n");
        return;
    }

    if (vertices > 1 && mstCount == 0)
    {
        printf("\nPlease generate the minimum-cost network first.\n");
        return;
    }

    printf("\n============================================\n");
    printf("               REJECTED EDGES\n");
    printf("============================================\n");

    if (rejectedCount == 0)
    {
        printf("No cycle-forming edges were rejected.\n");
        return;
    }

    for (i = 0; i < rejectedCount; i++)
    {
        printf("%s - %s : %d -> Creates Cycle\n",
               city[rejected[i].source],
               city[rejected[i].destination],
               rejected[i].cost);
    }
}

int main()
{
    int choice;

    do
    {
        printf("\n\n");
        printf("============================================\n");
        printf("      MINIMUM-COST CITY NETWORK PLANNER\n");
        printf("             KRUSKAL'S ALGORITHM\n");
        printf("============================================\n");

        printf("1. Enter Cities\n");
        printf("2. Add Connections by Source City\n");
        printf("3. Display Cities\n");
        printf("4. Display Connections\n");
        printf("5. Generate Minimum-Cost Network\n");
        printf("6. Display MST\n");
        printf("7. Display Rejected Edges\n");
        printf("8. Exit\n");

        printf("\nEnter your choice: ");

        if (scanf("%d", &choice) != 1)
        {
            printf("Invalid input.\n");
            return 1;
        }

        switch (choice)
        {
            case 1:
                enterCities();
                break;

            case 2:
                addConnection();
                break;

            case 3:
                displayCities();
                break;

            case 4:
                displayConnections();
                break;

            case 5:
                kruskal();
                break;

            case 6:
                displayMST();
                break;

            case 7:
                displayRejected();
                break;

            case 8:
                printf("\nThank you for using the City Network Planner!\n");
                break;

            default:
                printf("\nInvalid choice. Please try again.\n");
        }

    } while (choice != 8);

    return 0;
}